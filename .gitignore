# ========================================
# Global (최상위 및 모든 하위 폴더 공통 적용)
# ========================================
.DS_Store
*.log
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json
*.env
*.env.*
!*.env.example

# AI작성: 실행 위치에 따라 생성되는 사용자 업로드 파일 제외
/uploads/
/back/uploads/

# ========================================
# Frontend - React (/front)
# ========================================

# Logs
/front/logs/
/front/npm-debug.log*
/front/yarn-debug.log*
/front/yarn-error.log*
/front/pnpm-debug.log*
/front/lerna-debug.log*

# Dependencies & Build
/front/node_modules/
/front/dist/
/front/dist-ssr/
/front/*.local

# Editor directories and files
/front/*.suo
/front/*.ntvs*
/front/*.njsproj
/front/*.sln

# ========================================
# Backend - Spring Boot (/back)
# ========================================

/back/HELP.md
/back/.gradle/
/back/.gradle-user/
/back/build/
!/back/gradle/wrapper/gradle-wrapper.jar
!/back/**/src/main/**/build/
!/back/**/src/test/**/build/

# STS
/back/.apt_generated
/back/.classpath
/back/.factorypath
/back/.project
/back/.settings
/back/.springBeans
/back/.sts4-cache
/back/bin/
!/back/**/src/main/**/bin/
!/back/**/src/test/**/bin/

# IntelliJ IDEA
/back/*.iws
/back/*.iml
/back/*.ipr
/back/out/
!/back/**/src/main/**/out/
!/back/**/src/test/**/out/

# NetBeans
/back/nbproject/private/
/back/nbbuild/
/back/dist/
/back/nbdist/
/back/.nb-gradle/

# 비밀번호가 포함된 로컬 DB 설정 및 YAML 파일 제외
/back/src/main/resources/application.yaml
/back/src/main/resources/application.yml
/back/src/main/resources/application-*.yaml
/back/src/main/resources/application-*.yml
